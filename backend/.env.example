# Reca backend — copy to .env and fill in (never commit .env)
PORT=3000

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Optional — if empty, Reca uses preset explanations/questions only
ANTHROPIC_API_KEY=

# Demo: resurface due items after N minutes (use 1–2 for live demo)
RESURFACE_MINUTES=2

# Set to true to log webhooks without sending WhatsApp (local dry-run)
DRY_RUN=false
