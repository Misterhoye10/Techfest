# Reca backend — copy to .env and fill in (never commit .env)
PORT=3000

# ========== Meta WhatsApp Cloud API (from GitHub main / ai-study-companion-backend) ==========
# developers.facebook.com → your app → WhatsApp → API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Must match the Verify Token you set in Meta webhook config
META_VERIFY_TOKEN=reca_webhook_token
# Optional — shown in UI (E.164), e.g. +1555...
META_DISPLAY_PHONE_NUMBER=
# Optional override (default v18.0 — same as main branch)
# META_API_VERSION=v18.0

# AI — Gemini (preferred free tier). If empty, Reca uses preset bank only.
GEMINI_API_KEY=
# Optional override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Demo: resurface due items after N minutes (use 1–2 for live demo)
RESURFACE_MINUTES=2

# Set true to log WhatsApp without sending (local)
DRY_RUN=false

# ========== Shared Supabase (from backend team) ==========
# Never commit real credentials. Rotate if this URL was shared in chat.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres?schema=public

# Live Meta WhatsApp backend (Render) — web does NOT call Meta/Gemini directly
RECA_WHATSAPP_NUMBER=15556777893
RECA_ALERT_URL=https://reca-study-companion.onrender.com/api/send-alert
