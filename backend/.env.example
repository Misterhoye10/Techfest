# Reca backend — copy to .env and fill in (never commit .env)
PORT=3000
NODE_ENV=development

# ========== Security (set before public / competition traffic) ==========
# Competition gate for /demo /debug /api/send-alert — header: x-demo-secret
DEMO_SECRET=change-me-before-fest
# production: demo routes 404 unless BOTH are set
ENABLE_DEMO=true
# Optional CORS allow-list (comma-separated). Empty = same-origin only.
# CORS_ORIGIN=https://reca-study-companion.onrender.com
# TRUST_PROXY_HOPS=1
# HEALTH_DETAIL=false

# ========== Meta WhatsApp Cloud API ==========
# developers.facebook.com → your app → WhatsApp → API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Must match the Verify Token you set in Meta webhook config — do NOT leave the default
META_VERIFY_TOKEN=change-me-unique-token
# App secret — required to verify X-Hub-Signature-256 on webhook POST (required in production)
META_APP_SECRET=
# Optional — shown in UI (E.164), e.g. +1555...
META_DISPLAY_PHONE_NUMBER=
# META_API_VERSION=v18.0

# AI — Gemini (preferred free tier). If empty, Reca uses preset bank only.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# University admin AI feed — fetches official pages, summarizes with Gemini
# UNI_FEED_ENABLED=true
# UNI_FEED_CRON=0 6 * * *
# UNI_FEED_TZ=Africa/Lagos
# UNI_UPDATE_CRON=0 8 * * 1-5

# Demo: resurface due items after N minutes (use 1–2 for live demo)
RESURFACE_MINUTES=2

# Set true to log WhatsApp without sending (local)
DRY_RUN=false
# Echo OTP in API response — NEVER on production (blocked when NODE_ENV=production)
OTP_ECHO=false

# ========== Shared Supabase ==========
# Never commit real credentials. Rotate if this URL was shared in chat.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres?schema=public

# Live Meta WhatsApp backend (Render)
RECA_WHATSAPP_NUMBER=15556777893
RECA_ALERT_URL=https://reca-study-companion.onrender.com/api/send-alert
